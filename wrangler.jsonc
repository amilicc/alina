{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "your-worker-name",

  "compatibility_date": "2025-04-01",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "main": "./src/worker/index.ts",

  "workers_dev": true,

  "preview_urls": true,

  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "observability": {
    "enabled": true
  }
}
